{
    "manifest_version": 3,
    "name": "doitfirst",
    "version": "1.0",
    "description": "Block social media sites with a todo list modal until you complete a task",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "content_scripts": [
      {
        "matches": [
          "*://twitter.com/*", 
          "*://x.com/*", 
          "*://www.youtube.com/*", 
          "*://youtube.com/*", 
          "*://www.instagram.com/*", 
          "*://instagram.com/*", 
          "*://www.tiktok.com/*", 
          "*://tiktok.com/*"
        ],
        "js": ["content.js"],
        "css": ["styles.css"],
        "run_at": "document_idle"
      }
    ],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": false
    }
  }