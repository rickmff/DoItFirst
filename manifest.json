{
    "manifest_version": 3,
    "name": "doitfirst",
    "version": "1.1",
    "description": "Block social media with a todo list until you finish your tasks, and hide YouTube Shorts and recommendations",
    "icons": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "permissions": [
      "storage"
    ],
    "content_scripts": [
      {
        "matches": [
          "*://twitter.com/*", 
          "*://x.com/*", 
          "*://www.youtube.com/*", 
          "*://youtube.com/*", 
          "*://www.instagram.com/*", 
          "*://instagram.com/*", 
          "*://www.tiktok.com/*", 
          "*://tiktok.com/*"
        ],
        "js": ["content.js"],
        "css": ["styles.css"],
        "run_at": "document_idle"
      },
      {
        "matches": [
          "*://www.youtube.com/*",
          "*://youtube.com/*"
        ],
        "js": ["youtube.js"],
        "css": ["youtube.css"],
        "run_at": "document_start"
      }
    ],
    "options_ui": {
      "page": "options.html",
      "open_in_tab": false
    }
  }